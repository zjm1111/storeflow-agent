# 第 2 周 Docker Compose 的本地基础设施配置；不要提交真实密钥。
MYSQL_DATABASE=supplymind
MYSQL_USER=supplymind
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_URL=mysql+pymysql://supplymind:change-me@mysql:3306/supplymind
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
FRONTEND_ORIGINS=http://localhost:5173
ENVIRONMENT=development
# Set a high-entropy value in production. Clients then send it as X-API-Key.
API_KEY=
# JWT is optional only in development/test. In production it is mandatory.
# This local demo account source is deliberately explicit; replace it with an
# identity provider / secret manager before a real deployment.
JWT_SECRET=
JWT_ISSUER=supplymind
JWT_AUDIENCE=supplymind-web
JWT_ACCESS_TTL_MINUTES=60
# Example (keep passwords out of git):
# JWT_USERS_JSON=[{"username":"operator","password":"change-me","role":"operator","workspace_id":"demo"},{"username":"reviewer","password":"change-me","role":"reviewer","workspace_id":"demo"}]
JWT_USERS_JSON=
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120

# 可选：仅由 API 容器读取，绝不以 VITE_/前端环境变量暴露。
# Key 与同地域/同计费方案的 Base URL 必须成对配置；留空时使用确定性本地降级。
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
# 例如北京 Dashscope 共享域名：https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
# qwen3-rerank 专用。填入业务空间 URL，例如：
# https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-api/v1
BAILIAN_RERANK_BASE_URL=
# 默认 local：免费、可解释的本地重排；填 bailian 才调用 qwen3-rerank。
RERANK_PROVIDER=local
BAILIAN_TIMEOUT_SECONDS=25
# Optional local rate for cost estimates; 0 means the UI shows "rate not configured".
BAILIAN_COST_PER_1K_TOKENS_USD=0
MODEL_ENRICHMENT_ENABLED=false

# 可选实时新闻检索；留空时继续使用现有公开检索与本地降级。
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=3
TAVILY_TIME_RANGE=week
# Optional local rate for each Tavily request; 0 means the UI shows "rate not configured".
TAVILY_COST_PER_REQUEST_USD=0
